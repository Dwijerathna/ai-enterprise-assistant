# Application
APP_NAME=Enterprise AI Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Server
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# Database (matches docker-compose postgres service)
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_ai

# Logging
LOG_LEVEL=INFO
